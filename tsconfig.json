{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "scripts", "tests", "*.ts"],
  "exclude": ["dist", "node_modules", "coverage"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  }
}
