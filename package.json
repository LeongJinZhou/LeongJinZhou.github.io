{
  "name": "leongjinzhou-github-io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit && tsc -p scripts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "prebuild": "node -e \"const f=require('fs'),s=process.env.DATA_DIR+'/shots';f.rmSync('public/shots',{recursive:true,force:true});process.env.DATA_DIR&&f.existsSync(s)&&f.cpSync(s,'public/shots',{recursive:true,force:true})\"",
    "build:ci": "node -e \"process.env.DATA_DIR='tests/fixtures/generated';process.env.HIDDEN_FILE='tests/fixtures/hidden.txt';require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "astro": "7.4.12",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "1.65.1",
    "@types/hast": "3.0.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.8",
    "basic-ftp": "6.2.6"
  }
}
