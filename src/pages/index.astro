---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { OWNER } from '../../scripts/lib/github.ts'
import { badgeUrl, loadProjects, loadSite, techList } from '../lib/data.ts'

const site = loadSite()
const { projects, featured } = loadProjects()
const techs = techList(projects)
const [intro = '', ...points] = site.about
const githubUrl = `https://github.com/${OWNER}`
---

<Base title={`${site.name} — ${site.title}`} description={`${site.name}, ${site.title}. ${site.pitch}`}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <p class="prompt">$ whoami<span class="cursor" aria-hidden="true"></span></p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="role">{site.title}</p>
      <p class="pitch">{site.pitch}</p>
      <p class="cta">
        <a class="btn btn-primary" href="#featured">See my work</a>
        <a class="btn" href={githubUrl}>GitHub</a>
        {site.linkedinUrl && <a class="btn" href={site.linkedinUrl}>LinkedIn</a>}
      </p>
    </div>
  </section>

  <section id="about" aria-labelledby="about-h">
    <div class="wrap">
      <h2 id="about-h">About</h2>
      <p class="lead">{intro}</p>
      <ul class="points">
        {
          points.map((p) => {
            const [label, ...rest] = p.split(': ')
            return rest.length > 0 ? (
              <li>
                <strong>{label}</strong> {rest.join(': ')}
              </li>
            ) : (
              <li>{p}</li>
            )
          })
        }
      </ul>
    </div>
  </section>

  <section id="featured" aria-labelledby="featured-h">
    <div class="wrap">
      <h2 id="featured-h">Featured projects</h2>
      {featured.length === 0 && <p class="empty">No featured projects yet.</p>}
      <div class="grid">{featured.map((p) => <ProjectCard project={p} />)}</div>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <h2 id="projects-h">All projects</h2>
      {projects.length === 0 && <p class="empty">No public projects yet.</p>}
      <div class="filter" data-filter hidden>
        <div role="group" aria-label="Filter by technology" class="chips">
          <button type="button" class="chip" data-tech="" aria-pressed="true">All</button>
          {techs.map((t) => <button type="button" class="chip" data-tech={t.toLowerCase()} aria-pressed="false">{t}</button>)}
        </div>
        <p class="count" role="status" data-count></p>
      </div>
      <div class="empty" data-testid="filter-empty" hidden>
        <p>No project uses every selected technology.</p>
        <button type="button" class="btn">Reset filters</button>
      </div>
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-h">
    <div class="wrap">
      <h2 id="skills-h">Skills</h2>
      <ul class="badges">
        {site.skills.map((s) => <li><img src={badgeUrl(s)} alt={s} height="20" loading="lazy" decoding="async" /></li>)}
      </ul>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <h2 id="contact-h">Contact</h2>
      <p>The best way to reach me is through my profiles.</p>
      <p class="cta">
        <a class="btn btn-primary" href={githubUrl}>GitHub</a>
        {site.linkedinUrl && <a class="btn" href={site.linkedinUrl}>LinkedIn</a>}
      </p>
    </div>
  </section>

  <script>
    import '../scripts/filter.ts'
  </script>
</Base>
