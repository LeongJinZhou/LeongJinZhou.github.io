---
import type { Project } from '../../scripts/lib/schemas.ts'
import { stackOf } from '../lib/data.ts'
import ProjectShot from './ProjectShot.astro'

interface Props {
  project: Project
}
const { project: p } = Astro.props
const stack = stackOf(p)
---

<article class="card" data-testid="project-card" data-name={p.name} data-tech={stack.map((t) => t.toLowerCase()).join('|')}>
  <ProjectShot project={p} />
  <div class="card-body">
    <h3><a href={`/projects/${p.name}/`}>{p.title}</a></h3>
    <p>{p.description}</p>
    <ul class="tags" aria-label="Stack">
      {stack.slice(0, 4).map((t) => <li>{t}</li>)}
    </ul>
  </div>
</article>
