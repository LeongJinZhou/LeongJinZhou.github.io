---
import type { Languages } from '../../scripts/lib/schemas.ts'
import { languageShares } from '../lib/data.ts'

interface Props {
  languages: Languages
}
const shares = languageShares(Astro.props.languages)
let x = 0
const segs = shares.map((s, i) => {
  const seg = { ...s, i, x }
  x += s.pct
  return seg
})
const label = shares.map((s) => `${s.name} ${Math.round(s.pct)}%`).join(', ')
---

{
  shares.length > 0 && (
    <div class="langs">
      <svg viewBox="0 0 100 3" width="100" height="3" preserveAspectRatio="none" role="img" aria-label={`Languages: ${label}`}>
        {segs.map((s) => <rect class={`seg seg-${s.i}`} x={s.x.toFixed(2)} y="0" width={s.pct.toFixed(2)} height="3" />)}
      </svg>
      <ul class="legend">
        {segs.map((s) => <li class={`seg-${s.i}`}>{s.name} <span>{Math.round(s.pct)}%</span></li>)}
      </ul>
    </div>
  )
}
